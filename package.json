{
  "name": "workroom-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local product records and portfolio workspace with an MCP interface",
  "license": "MIT",
  "type": "module",
  "main": "src/desktop/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "mcp": "node src/mcp/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:ui": "node scripts/checks/check-overview-app.cjs",
    "check:app": "node scripts/checks/run-all.cjs",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "playwright-core": "1.62.1",
    "prettier": "3.9.9"
  }
}
